{
  "name": "@nono-k/bls",
  "version": "0.0.1",
  "description": "Browse Letter Spacing",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./bls.css": "./dist/bls.css"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && cp src/bls.css dist/bls.css",
    "dev": "vite playground",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nono-k/bls.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nono-k/bls/issues"
  },
  "homepage": "https://github.com/nono-k/bls#readme",
  "devDependencies": {
    "jsdom": "^31.0.1",
    "pug": "^3.0.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "volta": {
    "node": "22.23.5"
  }
}
